 // window capture is earlier in the event path, so local slash commands are
 // consumed before they can become an "Unknown command" chat message.
 window.addEventListener('keydown',event=>{const node=event.target;if(node instanceof HTMLInputElement||node instanceof HTMLTextAreaElement)consume(event,node)},true);
 window.addEventListener('keypress',event=>{const node=event.target;if(node instanceof HTMLInputElement||node instanceof HTMLTextAreaElement)consume(event,node)},true);
 window.addEventListener('submit',event=>{const node=document.activeElement;if((node instanceof HTMLInputElement||node instanceof HTMLTextAreaElement)&&isChat(node)&&command(node.value)){event.preventDefault();event.stopImmediatePropagation();setValue(node,'')}},true);
 window.LocalOnlineRoomSettings={read,save,apply,snapshot};
})(document,window);
;(function installPatchDeleteUI(document, window) {
 if(window.location.protocol!=='https:')return;
 const install=()=>{
  const account=document.getElementById('config_account');
  const config=account?.closest?.('[data-menuview="config"]')||document.querySelector('[data-menuview="config"]');
  if(!account||!config||document.getElementById('qp-patch-delete-entry'))return;
  const template=document.getElementById('config_export')||account;
  const makeEntry=(id,titleText,detailText)=>{const node=document.createElement('div');node.id=id;node.className=template.className||'scroller_item scroller_item_config has_description ns rg_target_pri';node.setAttribute('role','button');node.tabIndex=0;const title=document.createElement('h1'),detail=document.createElement('p');title.textContent=titleText;detail.textContent=detailText;node.append(title,detail);return node};
  const paused=window.localStorage?.getItem('qp-patch-online-tools-paused-v1')==='1';
  const toggle=makeEntry('qp-patch-tools-toggle',paused?'QP TOOLS: PAUSED':'QP TOOLS: ON',paused?'クリックでツールを再開します':'クリックでツールを一時停止し、画面から外します');
  const toggleTools=()=>{if(paused)window.localStorage?.removeItem('qp-patch-online-tools-paused-v1');else window.localStorage?.setItem('qp-patch-online-tools-paused-v1','1');window.location.reload()};
  toggle.addEventListener('click',event=>{event.preventDefault();event.stopImmediatePropagation();toggleTools()},true);
  toggle.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleTools()}},true);
  const entry=document.createElement('div');entry.id='qp-patch-delete-entry';
  entry.className=template.className||'scroller_item scroller_item_config has_description ns rg_target_pri';
  entry.setAttribute('role','button');entry.tabIndex=0;
  const title=document.createElement('h1');title.textContent='TETR.IO PATCH DELETE';
  const detail=document.createElement('p');detail.textContent='パッチを安全に削除して元のTETR.IOへ戻す';
  entry.append(title,detail);
  const close=()=>document.getElementById('qp-patch-delete-dialog')?.remove();
  const open=()=>{
   close();
   const dialog=document.createElement('section');dialog.id='qp-patch-delete-dialog';dialog.setAttribute('role','dialog');dialog.setAttribute('aria-modal','true');
   dialog.style.cssText='position:fixed;z-index:2147483647;left:50%;top:50%;width:min(540px,86vw);transform:translate(-50%,-50%);padding:22px;background:#f3f3f3;color:#242424;border-radius:3px;box-shadow:0 0 0 100vmax #000b;font:600 16px system-ui';
   const heading=document.createElement('h2');heading.textContent='TETR.IOパッチを削除しますか？';heading.style.margin='0 0 12px';
   const body=document.createElement('p');body.textContent='本体を起動したままでは安全に削除できません。TETR.IOを完全に終了した後、配布フォルダの共通削除ファイルを実行してください。';
   const warning=document.createElement('p');warning.textContent='注意：ローカル記録・自作復活ミッション・AIデータは削除されません。削除後も端末内に残ります。';warning.style.cssText='padding:10px;background:#ffb8b8;color:#b00000;font-weight:800';
   const hint=document.createElement('p');hint.textContent='Mac: TETRIO-Patch-Remove-4.11-Mac.command / Windows: TETRIO-Patch-Remove-4.11-Windows.cmd / Linux: TETRIO-Patch-Remove-4.11-Linux.sh';hint.style.fontSize='13px';
   const cancel=document.createElement('button'),ok=document.createElement('button');cancel.textContent='キャンセル';ok.textContent='確認しました';
   for(const button of [cancel,ok])button.style.cssText='width:48%;margin:1%;padding:10px;border:0;font:700 16px system-ui';cancel.style.background='#bbb';ok.style.cssText+=';background:#ff6b50;color:#fff';cancel.onclick=close;ok.onclick=close;
   dialog.append(heading,body,warning,hint,cancel,ok);document.body.appendChild(dialog);ok.focus();
  };
  entry.addEventListener('click',event=>{event.preventDefault();event.stopImmediatePropagation();open()},true);
  entry.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();open()}},true);
  const footer=document.createElement('div');footer.id='qp-patch-tools-footer';footer.className='scroller_block zero';
  const heading=document.createElement('h2');heading.className='ns';heading.textContent='QP PATCH TOOLS';heading.style.cssText='margin:.8em 0 .25em;color:#ff9866';footer.appendChild(heading);
  config.append(footer,toggle,entry);
 };
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',install,{once:true});else install();
})(document,window);
