 const read = () => {try {const value=JSON.parse(localStorage.getItem(key)||localStorage.getItem('qp-local-room-presets-fallback-v1')||'{"schema":1,"presets":[]}');return value?.schema===1&&Array.isArray(value.presets)?value:{schema:1,presets:[]}} catch {return {schema:1,presets:[]}}};
