    option.textContent=slot.name+' · '+(slot.scope==='online'?'オンライン専用・端末保存':'完全ローカル')+' · Lv.'+slot.data.level;
    select.appendChild(option);
   }
   select.value=store.selection()||'';
   status.textContent=store.active()?'この枠は端末内に保存され、公式記録へ同期されません。':'通常ZENを使用します。';
