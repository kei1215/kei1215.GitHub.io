/* vA native headless AI integration: same rules engine, isolated game state. */
window.LocalNative.createAISandbox = function createAISandbox(game) {
  if (!game?.options || game.options.version !== 19) throw Error('AI探索はゲームルール version 19 専用です');
  const options = {
    ...game.options, gameid: 8180, noreplay: true, can_retry: false,
    display_replay: false, seed_random: false,
    countdown: false, precountdown: 0, prestart: 0,
  };
  const sandbox = new v('pipe');
  try {
    sandbox.setHeadless(true);
    sandbox.source.IsSocketLike = () => false;
    sandbox.source.self.iom.scoped = true;
    sandbox.source.self.iom.synced = true;
    sandbox.setGame(options);
    sandbox.startGame();
    if (!sandbox.source?.self?.fm?.GetPieceDefinition ||
        typeof sandbox.injectState !== 'function' ||
        typeof sandbox.ejectState !== 'function') throw Error('ネイティブ探索エンジンが初期化されませんでした');
    return sandbox;
  } catch (error) {
    try { sandbox.destroy(); } catch {}
    throw error;
  }
};
window.LocalNative.learnReplay = async function learnReplay(data, attach, onProgress, isCancelled, drain) {
  const info = window.LocalTTRFormat?.inspect(data);
  if (!info) throw Error('TTRの検証器が読み込まれていません');
  const replay = new L(info.replay);
  const game = new v('replay', { replay });
  try {
    game.setHeadless(true);
    game.setGame({...info.replay.options, seed_random: false,
      gameid: info.replay.options.gameid ?? 8181, noreplay: true,
      precountdown: 0, prestart: 0, countdown: false});
    attach(game);
    await game.startGame();
    const count = info.frames;
    for (let i = 0; i < count && game.isPlaying(); i++) {
      if (isCancelled?.()) throw Error('TTR学習をキャンセルしました');
      game.doFrame();
      if (i % 120 === 119 || i === count - 1) {
        onProgress?.(i + 1, count);
        await drain?.();
        await new Promise(resolve => setTimeout(resolve, 0));
      }
    }
    await drain?.();
    onProgress?.(count, count);
    return {mode: info.mode, frames: count, pieces: game.state.stats.piecesplaced};
  } finally {
    try { game.destroy(); } catch (error) { console.warn('[vA TTR cleanup]', error); }
  }
};

